
#include <cmath>
#include <vector>
#include <random>
#include <numbers>
#include <iostream>
#include <stdexcept>

class SignalGenerator{
	private:
		double sampleRate;
		int numOfSamples, desiredFreq, interferenceFreq;

	public:	std::vector<double> genSignal(double sampleRate, int numOfSamples, int desiredFreq){
			// init array
			std::vector<double> samples(numOfSamples, 0);
			// from time 0 to 1024 calc a sample and insert back into array
			for(int i = 0; i < numOfSamples; i++){
				double time = static_cast<double> (i) / sampleRate;
				double calc = 2 * std::numbers::pi * desiredFreq * time;
				calc = std::sin(calc);
				samples[i] = calc;
			}
			return samples;
		}

	public:	std::vector<double> genInterference(double sampleRate, int numOfSamples, int interferenceFreq){
                        // init array
                        std::vector<double> interferenceSamples(numOfSamples, 0);
                        // from time 0 to 1024 calc a sample and insert back into array
                        for(int i = 0; i < numOfSamples; i++){
                                double time = static_cast<double> (i) / sampleRate;
                                double calc = 2 * std::numbers::pi * interferenceFreq * time;
                                calc = std::sin(calc);
                                interferenceSamples[i] = calc;
                        }
                        return interferenceSamples;
                }

	public:	std::vector<double> genNoise(int numOfSamples){
                        // init array and noise random gen
			std::mt19937 generator(42);
			std::uniform_real_distribution<double> dist(-0.2, 0.2);
                        std::vector<double> noiseSamples(numOfSamples, 0);
                        // from time 0 to 1024 calc a sample and insert back into array
                        for(int i = 0; i < numOfSamples; i++){
				noiseSamples[i] = dist(generator);
                        }
                        return noiseSamples;
                }

	public:	std::vector<double> combineSignals(const std::vector<double>& desired, const std::vector<double>& interference, const std::vector<double>& noise){
			// check if sizes match
                        if (desired.size() != interference.size() || interference.size() != noise.size()) {
    				throw std::invalid_argument("Signal vectors must have equal sizes");
			}

			// init array
                        std::size_t size = desired.size();
                        std::vector<double> combinedSamples(size, 0);

			// from time 0 to 1024 combine signals
                        for(size_t i = 0; i < size; i++){
                        	combinedSamples[i] = desired[i] + interference[i] + noise[i];
                        }
                        return combinedSamples;
                }
